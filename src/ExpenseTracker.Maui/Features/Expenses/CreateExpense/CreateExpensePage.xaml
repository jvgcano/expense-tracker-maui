<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ExpenseTracker.Maui.Features.Expenses.CreateExpense.CreateExpensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Expense">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">

            <Label
                Text="Add Expense"
                Style="{StaticResource Headline}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Amount" />

                <Entry
                    Keyboard="Numeric"
                    Placeholder="0.00"
                    Text="{Binding Amount}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Category" />

                <Picker
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding Category}"
                    Title="Select a category" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Date" />

                <DatePicker
                    Date="{Binding Date}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Description" />

                <Editor
                    AutoSize="TextChanges"
                    Placeholder="Enter a description"
                    Text="{Binding Description}" />
            </VerticalStackLayout>

            <Button
                Text="Save Expense"
                Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
